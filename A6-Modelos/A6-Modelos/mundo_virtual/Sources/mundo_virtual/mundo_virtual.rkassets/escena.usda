#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.60.2)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def "Cloud" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.570796, 0, 0)
        }
        references = @Modelos/Cloud.usdz@
    )
    {
        quatf xformOp:orient = (0.7071069, -0.70710665, 0, 0)
        float3 xformOp:scale = (0.1, 0.1, 0.1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "RCP_BehaviorsContainer"
        {
            rel behaviors = </Root/Cloud/OnAddedToScene>
            uniform token info:id = "RCP.BehaviorsContainer"
        }

        def Preliminary_Behavior "OnAddedToScene"
        {
            rel actions = </Root/Cloud/OnAddedToScene/Action>
            uniform bool exclusive
            rel triggers = </Root/Cloud/OnAddedToScene/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/Cloud>
                token info:id = "SceneTransition"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = </Root>
                rel animationLibraryKey = </Root/Rotacion>
                rel animationLibraryKeyOverrideKey = </Root/Cloud/OnAddedToScene/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }
    }

    def RealityKitTimeline "Rotacion"
    {
        reorder nameChildren = ["Track3", "Track", "Track2"]
        def RealityKitTrack "Track2"
        {
        }

        def RealityKitTrack "Track3"
        {
            def RealityKitAction "Spin"
            {
                string actionKind = "spin"
                int blendLayer = 400
                double duration = 2
                uniform token info:id = "933B971B-ECBA-4296-AE8A-504C88539C6B"
                float3 localAxis = (0, 0, 1)
                double startTime = 0
                rel target = </Root/Cloud>

                def RealityKitStruct "timingFunction"
                {
                    token type = "linear"
                }
            }
        }
    }
}

