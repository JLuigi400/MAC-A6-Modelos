def Xform "Root"
{
    reorder nameChildren = ["rotacion", "salto", "salto_giro"]
    def "Moon" (
        active = true
        references = @cloud.usdz@
    )
    {
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "RCP_BehaviorsContainer"
        {
            rel behaviors = [
                </Root/Moon/OnNotification>,
                </Root/Moon/OnAddedToScene>,
            ]
            uniform token info:id = "RCP.BehaviorsContainer"
        }

        def Preliminary_Behavior "OnNotification"
        {
            rel actions = </Root/Moon/OnNotification/Action>
            uniform bool exclusive
            rel triggers = </Root/Moon/OnNotification/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/Moon>
                string identifier = "da_un_salto"
                token info:id = "Notification"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = </Root>
                rel animationLibraryKey = </Root/salto>
                rel animationLibraryKeyOverrideKey = </Root/Moon/OnNotification/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }

        def Preliminary_Behavior "OnAddedToScene"
        {
            rel actions = </Root/Moon/OnAddedToScene/Action>
            uniform bool exclusive
            rel triggers = </Root/Moon/OnAddedToScene/Trigger>

